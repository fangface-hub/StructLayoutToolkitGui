{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Pytest (single test)",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-k", "${input:test_name}"
            ],
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "test_name",
            "type": "promptString",
            "description": "Enter pytest -k expression",
            "default": "test_bits_get_cross_byte"
        }
    ]
}